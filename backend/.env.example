# Required: MongoDB Atlas connection string (keep this server-side only).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=aishield

# Shared scanner -> dashboard ingestion secret. Add the same value as
# AISECURITY_UPLOAD_TOKEN in GitLab CI/CD variables. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AISHIELD_INGEST_TOKEN=replace-with-a-long-random-ingest-secret

# Public deployment origins. PUBLIC_BASE_URL is the Next.js website.
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Gemini is only used after explicit user consent on the dashboard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitLab verification pipeline (optional until you configure automatic verification).
# Create a pipeline trigger token in the AIShield Scanner GitLab project.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_VERIFICATION_PROJECT_ID=
GITLAB_VERIFICATION_REF=main
GITLAB_VERIFICATION_TRIGGER_TOKEN=
GITLAB_VERIFICATION_ENGINE_IMAGE=registry.gitlab.com/<namespace>/<scanner-project>/engine:<version>

# Upload / retrieval limits.
MAX_REPORT_BYTES=10000000
MAX_SOURCE_FILE_BYTES=300000
